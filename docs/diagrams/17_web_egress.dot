digraph web_egress {
    graph [bgcolor="#0d1117", rankdir=LR, fontname="Helvetica", fontcolor="#e6edf3", labelloc="t", fontsize=20,
           label="17 · Web egress: every web call is asked, vetted, pinned, bounded and labelled\n ", nodesep=0.3, ranksep=0.45];
    node  [fontname="Helvetica", fontcolor="#e6edf3", color="#30363d", style="filled,rounded", shape=box, penwidth=2,
           margin="0.2,0.14", fillcolor="#161b22", fontsize=12];
    edge  [color="#8b949e", fontname="Helvetica", fontcolor="#adbac7", penwidth=1.5, arrowsize=0.85, fontsize=10];

    model [label="Model proposes\nweb_fetch(url)\n(data, not authority)", color="#58a6ff", fillcolor="#13294d"];
    subgraph cluster_h {
        label="malyutka (no TLS, no HTML parsing)"; fontcolor="#bc8cff"; color="#bc8cff"; style="rounded,dashed";
        url  [label="web.url layer\nscheme · userinfo · secret formats\nprivate/metadata literals · denylist\nnon-canonical IPs", color="#3fb950"];
        deny [label="DENY (final:\nno approver sees it)", color="#f85149", fillcolor="#3a1518"];
        ask  [label="web.ask layer → ASK\nmandate → approver → deny\n(approval shows the exact URL)", color="#d29922"];
        jr   [label="journal intent/decision/\nstarted/outcome (B3)", color="#d29922"];
        call [label="callHelper\none JSON line out,\none JSON line in, deadline", color="#bc8cff"];
    }
    subgraph cluster_s {
        label="bwrap: network shared · NO workspace · NO state dir · NO $HOME"; fontcolor="#f0883e"; color="#f0883e"; style="rounded";
        res  [label="resolve ONCE per hop\nvet EVERY answer\n(private/metadata ⇒ refuse)", color="#f0883e"];
        pin  [label="connect to the vetted IP\nTLS: chain + host name + SNI", color="#f0883e"];
        read [label="bounded read\nheaders 64 KiB · body 2 MiB\ntime · content-type allow-list", color="#f0883e"];
        redir[label="redirect? re-check the\nwhole URL, https→http refused,\nno headers forwarded", color="#f0883e"];
        txt  [label="HTML → text\n(linear time, no tree)", color="#f0883e"];
    }
    net   [label="the internet", shape=oval, color="#58a6ff", fillcolor="#13294d"];
    out   [label="result to the model:\n[web_fetch url · HTTP · type · chars a-b of N ·\nuntrusted page text]\npage text (our label cannot be forged)", color="#39c5cf", fillcolor="#0d2e2e"];

    model -> url;
    url -> deny [label="bad URL", color="#f85149"];
    url -> ask [label="ok"];
    ask -> jr [label="approved"];
    ask -> deny [label="denied / timeout", color="#f85149", style=dashed];
    jr -> call -> res -> pin -> net;
    net -> read [label="bytes"]; pin -> read [style=invis];
    read -> redir -> res [label="next hop", style=dashed];
    read -> txt -> out;
}
