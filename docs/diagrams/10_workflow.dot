digraph workflow {
    graph [bgcolor="#0d1117", fontname="Helvetica", fontcolor="#e6edf3", labelloc="t", fontsize=20, rankdir=TB,
           label="10 · Workflow: one agent turn (and where resume / approvals plug in)\nsolid = implemented in v0.3.4 · dashed amber = planned in specs SPEC-002/003\n ", nodesep=0.3, ranksep=0.4];
    node  [fontname="Helvetica", fontcolor="#e6edf3", color="#30363d", style="filled,rounded", shape=box, penwidth=2, margin="0.22,0.14", fillcolor="#161b22", fontsize=12];
    edge  [color="#8b949e", fontname="Helvetica", fontcolor="#adbac7", penwidth=1.5, arrowsize=0.85, fontsize=10];

    start [label="malyutka run [--resume:ID] <task>", shape=oval, color="#58a6ff", fillcolor="#13294d"];
    probe [label="Preflight\nworkspace guard · state dir disjoint\nbwrap probe (exit 3 on failure)\njournal open + unknown-outcome report", color="#f0883e"];
    resume [label="Load session\nvalidateTranscript\nrefuse if parent has unknown outcomes", color="#d29922", style="filled,rounded,dashed"];
    ask_model [label="Provider call\nmessages + advertised tools", color="#58a6ff", fillcolor="#13294d"];
    final [label="Plain answer?\n⟶ agent.final · session saved · exit 0", color="#3fb950"];
    prop [label="tool.proposed\n(call ids normalised)", color="#58a6ff"];
    reg [label="Registry lookup", color="#3fb950"];
    j1 [label="Journal: intent (fdatasync)", color="#d29922"];
    pol [label="Policy compose\nceiling · confinement · denylist", color="#3fb950"];
    approver [label="Approver (ASK)\nonce · session · always · deny\n300 s timeout ⟶ deny", color="#d29922", style="filled,rounded,dashed"];
    j2 [label="Journal: decision + started", color="#d29922"];
    exec [label="Execute\nbwrap shell / in-process tool", color="#f0883e"];
    j3 [label="Journal: outcome", color="#d29922"];
    obs [label="tool message answers call id\nrepeat-limit · max-steps checks", color="#39c5cf", fillcolor="#0d2e2e"];
    deny [label="DENIED / CANCELLED\nstill a reply", color="#f85149", fillcolor="#3a1518"];

    start -> probe -> resume [style=dashed, color="#d29922"];
    probe -> ask_model;
    resume -> ask_model [style=dashed, color="#d29922"];
    ask_model -> final [label="no tool calls"];
    ask_model -> prop [label="tool calls"];
    prop -> reg -> j1 -> pol -> j2 -> exec -> j3 -> obs;
    obs -> ask_model [label="next step"];
    pol -> approver [label="ASK", style=dashed, color="#d29922"];
    approver -> j2 [label="allow", style=dashed, color="#d29922"];
    reg -> deny [label="unknown", color="#f85149"];
    j1 -> deny [label="not durable", color="#f85149"];
    pol -> deny [label="DENY / ASK today", color="#f85149"];
    approver -> deny [label="deny / timeout", color="#f85149", style=dashed];
    deny -> obs [color="#f85149"];
}
